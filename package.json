    "format": "prettier --write .",
    "lint": "prettier --check . && eslint ."
  },
  "dependencies": {
    "@fontsource-variable/spline-sans-mono": "5.2.8",
    "@fontsource-variable/vollkorn": "5.2.10",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.0",
    "svelte": "5.56.4",
    "temporal-polyfill-lite": "0.4.2",
    "tinyexec": "1.2.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@types/node": "25.9.4",
    "@unleashy/eslint": "unleashy/eslint#cdf74b283b180cbffc759a28a7a1891de83b9ee3",
    "eslint": "10.6.0",
    "lightningcss": "1.32.0",
    "prettier": "3.9.4",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.2"
  },
  "packageManager": "yarn@4.17.0"
